;WITH Sample AS
(
    SELECT TOP (100)
           TRY_CAST(event_data AS xml) AS EventXml
    FROM sys.fn_xe_file_target_read_file(@XelPath, NULL, NULL, NULL)
    WHERE object_name = N'xml_deadlock_report'
)
SELECT
    R.Resource.value('local-name(.)', 'sysname') AS ResourceType,
    R.Resource.value('(@objectname)[1]', 'nvarchar(512)') AS ObjectName
INTO #DeadlockResources
FROM Sample AS S
CROSS APPLY S.EventXml.nodes('/event/data/value/deadlock/resource-list/*')
    AS R(Resource);

SELECT
    ResourceType,
    ObjectName,
    COUNT_BIG(*) AS Occurrences
FROM #DeadlockResources
GROUP BY ResourceType, ObjectName
ORDER BY Occurrences DESC;

DROP TABLE #DeadlockResources;

